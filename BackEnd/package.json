{
    "scripts": {
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "build": "tsc -p tsconfig.json",
        "clean": "powershell -Command \"Remove-Item -Recurse -Force dist\"",
        "clean:start:dev": "npm run clean && npm run build && npm run start:dev",
        "run": "npm run build && npm run start"
    },
    "dependencies": {
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/platform-express": "^12.1.0",
        "@prisma/client": "^5.22.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.6",
        "@nestjs/common": "^12.1.0",
        "@nestjs/core": "^12.1.0",
        "@nestjs/passport": "^12.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.2",
        "@types/passport-jwt": "^4.0.1",
        "prisma": "^5.22.0",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3"
    }
}
